# syntax=docker/dockerfile:1
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

COPY files/hexvault.run /tmp/hexvault.run
RUN chmod +x /tmp/hexvault.run \
    && /tmp/hexvault.run --mode unattended --initialization 0 --service 0 --prefix /opt/hexvault \
    && rm /tmp/hexvault.run

RUN --mount=type=bind,source=files/setup_hexvault.py,target=/tmp/setup_hexvault.py \
    python3 /tmp/setup_hexvault.py

RUN cp /opt/hexvault/hexvault.conf.example /opt/hexvault/hexvault.conf \
    && chmod 640 /opt/hexvault/hexvault.conf

COPY --chmod=755 files/server_common.sh files/hexvault_entry.sh /usr/local/bin/
WORKDIR /opt/hexvault
VOLUME ["/opt/hexvault/files", "/opt/hexvault/tls"]
EXPOSE 65433
ENTRYPOINT ["/usr/local/bin/hexvault_entry.sh"]
