# syntax=docker/dockerfile:1
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates python3 default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

COPY files/lumina.run /tmp/lumina.run
RUN chmod +x /tmp/lumina.run \
    && /tmp/lumina.run --mode unattended --initialization 0 --service 0 --prefix /opt/lumina \
    && rm /tmp/lumina.run

RUN --mount=type=bind,source=files/setup_lumina.py,target=/tmp/setup_lumina.py \
    python3 /tmp/setup_lumina.py

COPY --chmod=640 files/lumina.conf /opt/lumina/lumina.conf
COPY --chmod=755 files/server_common.sh files/lumina_entry.sh /usr/local/bin/
WORKDIR /opt/lumina
VOLUME ["/opt/lumina/tls"]
EXPOSE 65432
ENTRYPOINT ["/usr/local/bin/lumina_entry.sh"]
